rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow authenticated users to create documents in the 'products' collection.
    match /products/{productId} {
      allow read, write: if request.auth != null;
    }
    
    // Allow authenticated users to read branches and users
    match /branches/{branchId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && getUserRole(request.auth.uid) == 'genel-mudur';
    }
    
    match /users/{userId} {
       allow read: if request.auth != null;
       allow write: if request.auth.uid == userId || (getUserRole(request.auth.uid) == 'genel-mudur' || getUserRole(request.auth.uid) == 'sube-muduru');
    }
    
		match /cashEntries/{cashEntryId} {
       allow read: if getUserRole(request.auth.uid) == 'genel-mudur';
       allow read, write: if getUserRole(request.auth.uid) == 'sube-muduru'
    }
		match /expenses/{expensesId} {
       allow read: if getUserRole(request.auth.uid) == 'genel-mudur';
       allow read, write: if getUserRole(request.auth.uid) == 'sube-muduru'
    }
    match /salesReports/{salesReportsId} {
       allow read: if getUserRole(request.auth.uid) == 'genel-mudur';
       allow read, write: if getUserRole(request.auth.uid) == 'sube-muduru'
    }
    // Rules for shifts
    match /shifts/{shiftId} {
    	allow read: if request.auth != null;
      allow read, write: if request.auth != null && (getUserRole(request.auth.uid) == 'genel-mudur' || getUserRole(request.auth.uid) == 'sube-muduru');
    }

    // Rules for performance
    match /performanceRules/{ruleId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (getUserRole(request.auth.uid) == 'genel-mudur' || getUserRole(request.auth.uid) == 'sube-muduru');
    }
    match /scoreEntries/{entryId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (getUserRole(request.auth.uid) == 'genel-mudur' || getUserRole(request.auth.uid) == 'sube-muduru');
    }
    
    // Helper function to get user's role
    function getUserRole(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.rol;
    }

    // Checklist Templates:
    // - Read: Any authenticated user can read templates (needed for daily checklists)
    // - Write (Create, Update, Delete): Only managers can modify templates
    match /checklistTemplates/{templateId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (getUserRole(request.auth.uid) == 'genel-mudur' || getUserRole(request.auth.uid) == 'sube-muduru');
    }
    
    // Completed Checklists:
    // Any authenticated user can create and update their daily checklist instances
    match /completedChecklists/{completedId} {
        allow read, create, update: if request.auth != null;
    }
    
    // Rules for stock counts
    match /stockCounts/{countId} {
       allow read, create: if request.auth != null;
    }
  }
}
